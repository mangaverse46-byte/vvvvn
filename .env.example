# Telegram credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me

# Telegram numeric user IDs, comma-separated
ADMIN_IDS=123456789

# Optional forced subscription channel, e.g. @YourChannel
FORCE_CHANNEL=

# Manga source API base URL. Leave blank until API contract is confirmed.
MANGA_API_BASE=https://manga-source-compass.lovable.app/api/public
MANGA_API_KEY=

# Optional PDF service URL. Leave blank to disable PDF delivery.
PDF_API_URL=
